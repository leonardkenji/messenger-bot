<%# Dark professional theme overrides %>
<% content_for :body_class, "bg-zinc-950 text-zinc-100" %>
<% content_for :nav_class, "border-b border-zinc-800 bg-zinc-900" %>
<% content_for :nav_logo_class, "font-display italic font-bold text-lg tracking-tight text-zinc-100" %>
<% content_for :nav_label_class, "font-mono text-xs tracking-widest uppercase text-zinc-500" %>
<% content_for :main_class, "h-[calc(100vh-57px)] overflow-hidden p-0" %>

<div class="flex h-full"
     data-controller="conversation-select search">

  <%# ═══════════════════════════════════════════════════════ SIDEBAR %>
  <aside class="w-[340px] xl:w-[380px] shrink-0 flex flex-col bg-zinc-900 border-r border-zinc-800 overflow-hidden">

    <%# Sidebar header %>
    <div class="px-5 py-4 border-b border-zinc-800 shrink-0">
      <div class="flex items-center justify-between mb-3">
        <h2 class="font-display font-bold text-lg text-zinc-100">会話一覧</h2>
        <div class="flex items-center gap-2">
          <span class="font-mono text-xs text-zinc-500 bg-zinc-800 border border-zinc-700 px-2 py-0.5">
            <%= @conversations.count %>
          </span>
          <%= button_to "更新", dashboard_scrape_path, method: :post,
              class: "font-mono text-xs text-zinc-600 hover:text-zinc-300 border border-zinc-700 hover:border-zinc-500 px-2 py-0.5 transition-colors" %>
        </div>
      </div>
      <input type="search"
             placeholder="会話を検索…"
             data-search-target="input"
             data-action="input->search#filter"
             class="w-full bg-zinc-800 border border-zinc-700 focus:border-zinc-500 focus:outline-none
                    text-zinc-200 placeholder-zinc-600 text-xs font-mono px-3 py-2 transition-colors">
    </div>

    <%# Stats strip %>
    <div class="grid grid-cols-3 border-b border-zinc-800 shrink-0">
      <div class="px-4 py-2.5 border-r border-zinc-800 text-center">
        <p class="font-mono text-xs text-emerald-400"><%= @conversations.count { |c| c.active? } %></p>
        <p class="font-mono text-xs text-zinc-600 uppercase tracking-wider mt-0.5">対応中</p>
      </div>
      <div class="px-4 py-2.5 border-r border-zinc-800 text-center">
        <p class="font-mono text-xs text-zinc-400"><%= @conversations.count { |c| !c.active? } %></p>
        <p class="font-mono text-xs text-zinc-600 uppercase tracking-wider mt-0.5">完了</p>
      </div>
      <div class="px-4 py-2.5 text-center">
        <p class="font-mono text-xs text-zinc-400"><%= @conversations.select { |c| c.created_at >= 7.days.ago }.count %></p>
        <p class="font-mono text-xs text-zinc-600 uppercase tracking-wider mt-0.5">今週</p>
      </div>
    </div>

    <%# Conversation list %>
    <div class="overflow-y-auto flex-1 scrollbar-thin">
      <% if @conversations.empty? %>
        <div class="px-5 py-16 text-center">
          <p class="font-body text-sm text-zinc-600 italic">会話がまだありません。</p>
        </div>
      <% else %>
        <% @conversations.each do |conversation| %>
          <%= render "conversations/conversation_item", conversation: conversation %>
        <% end %>
      <% end %>
    </div>

  </aside>

  <%# ═══════════════════════════════════════════════════════ MAIN PANEL %>
  <div class="flex-1 overflow-hidden bg-zinc-950">
    <%= turbo_frame_tag "conversation_panel", class: "block h-full overflow-y-auto" do %>
      <%# Empty state %>
      <div class="h-full flex items-center justify-center">
        <div class="text-center px-8 max-w-sm">
          <div class="text-zinc-800 mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-14 h-14 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
          </div>
          <h3 class="font-display text-xl text-zinc-600 mb-2">会話を選択してください</h3>
          <p class="font-body text-sm text-zinc-700 leading-relaxed">
            左のサイドバーから会話を選択すると、要約・営業アドバイス・メッセージ履歴が表示されます。
          </p>
        </div>
      </div>
    <% end %>
  </div>

</div>
