<%# Prepend new note to the top of the list %>
<%= turbo_stream.prepend "conversation_notes_list_#{@conversation.id}" do %>
  <%= render "conversation_notes/conversation_note", conversation_note: @note %>
<% end %>

<%# Replace the form with a fresh empty one %>
<%= turbo_stream.replace "conversation_note_form_#{@conversation.id}" do %>
  <%= render "conversation_notes/form", conversation: @conversation %>
<% end %>
