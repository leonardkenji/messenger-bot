<% last_msg = conversation.messages.last %>
<%= link_to conversation_path(conversation),
    id: dom_id(conversation),
    data: {
      turbo_frame: "conversation_panel",
      conversation_select_target: "item",
      search_target: "item",
      search_text: "#{conversation.customer.display_name} #{conversation.subject} #{last_msg&.content}",
      action: "click->conversation-select#select"
    },
    class: "block px-5 py-4 border-b border-zinc-800/70 transition-all duration-100
            border-l-[3px] border-l-transparent hover:bg-zinc-800/50 hover:border-l-zinc-600
            data-[selected]:bg-zinc-800 data-[selected]:border-l-blue-500 group" do %>
  <div class="flex items-start justify-between gap-2 mb-1.5">
    <div class="flex items-center gap-1.5 min-w-0">
      <%# Bot ON/OFF indicator dot %>
      <span class="shrink-0 w-1.5 h-1.5 rounded-full mt-0.5 <%= conversation.customer.auto_reply? ? 'bg-emerald-500' : 'bg-zinc-600' %>"
            title="<%= conversation.customer.auto_reply? ? 'BOT有効' : 'BOT停止' %>"></span>
      <span class="font-mono text-sm text-zinc-200 truncate">
        <%= conversation.customer.display_name %>
      </span>
    </div>
    <% if conversation.active? %>
      <span class="font-mono text-xs px-1.5 py-0.5 bg-emerald-500/15 text-emerald-400 border border-emerald-500/25 shrink-0 leading-tight">
        対応中
      </span>
    <% else %>
      <span class="font-mono text-xs px-1.5 py-0.5 bg-zinc-700/40 text-zinc-500 border border-zinc-700/60 shrink-0 leading-tight">
        完了
      </span>
    <% end %>
  </div>

  <% if conversation.subject.present? %>
    <p class="font-body text-xs italic text-zinc-400 mb-1.5 line-clamp-1">
      <%= conversation.subject %>
    </p>
  <% end %>

  <div class="flex items-end justify-between gap-2">
    <% if last_msg %>
      <p class="font-body text-xs text-zinc-600 group-data-[selected]:text-zinc-500 line-clamp-1 flex-1 leading-relaxed">
        <span class="font-mono text-zinc-700 text-xs"><%= last_msg.role == "user" ? "顧客：" : "BOT：" %></span>
        <%= last_msg.content %>
      </p>
    <% end %>
    <span class="font-mono text-xs text-zinc-700 shrink-0 group-data-[selected]:text-zinc-500">
      <%= conversation.updated_at.strftime("%m/%d %H:%M") %>
    </span>
  </div>
<% end %>
